# FastAPI Application Environment
ENVIRONMENT="production"
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:3000,https://trafficguard-ai.vercel.app"

# Computer Vision Model Configurations
YOLO_MODEL_PATH="weights/yolov8l.pt"
HELMET_MODEL_PATH="weights/helmet_mobilenetv3.onnx"
PLATE_DETECTOR_PATH="weights/wpod_net.pt"
CONFIDENCE_THRESHOLD=0.65
IOU_THRESHOLD=0.45
DEDUPLICATION_WINDOW_SECONDS=8.0

# Storage & Supabase Integration (Server-Side Only)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJh...YOUR_SERVICE_ROLE_KEY_NEVER_EXPOSE_PUBLICLY"
SUPABASE_STORAGE_BUCKET="traffic-evidence"
MAX_UPLOAD_SIZE_MB=250
TEMP_PROCESSING_DIR="/tmp/trafficguard_jobs"
